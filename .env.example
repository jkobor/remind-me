# ---------------------------------------------------------------------------
# LDAP authentication (required for multi-user login)
# ---------------------------------------------------------------------------

# LDAP server URL.
LDAP_SERVER=ldap://ldap.example.com

# LDAP server TCP port (default: 389; use 636 for LDAPS).
# LDAP_PORT=389

# Base DN for the directory, e.g. dc=example,dc=com.
LDAP_BASE_DN=dc=example,dc=com

# DN template used to bind as the authenticating user.
# {username} is replaced with the submitted username.
# Default: uid={username},{LDAP_BASE_DN}
# For Active Directory use: {username}@example.com
# LDAP_BIND_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com

# Search base for looking up user attributes after a successful bind.
# Defaults to LDAP_BASE_DN.
# LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com

# LDAP attribute that holds the login name (default: uid).
# Use sAMAccountName for Active Directory.
# LDAP_USER_ATTR=uid

# ---------------------------------------------------------------------------
# Zulip notifications (optional – reminders are still saved without it)
# ---------------------------------------------------------------------------

# Zulip bot credentials.
ZULIP_EMAIL=reminder-bot@example.zulipchat.com
ZULIP_API_KEY=your_api_key_here
ZULIP_SITE=https://example.zulipchat.com

# Global fallback recipient used when the per-user email cannot be determined
# (e.g. for single-user deployments or legacy reminders without a user_email).
ZULIP_TO=user@example.zulipchat.com

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------

SECRET_KEY=change-me-to-a-random-secret
DATABASE_PATH=~/.remind-me/reminders.db

# Public base URL of this app, used to generate snooze links in Zulip messages.
# Must be reachable by the Zulip recipient (e.g. via a tunnel when developing locally).
BASE_URL=http://localhost:5000
